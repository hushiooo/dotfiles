# Unified space navigator — the center of the repo/worktree workflow.
#
# Fuzzy-pick ANY git repo under ~/dev or one of its worktrees, then act on the
# highlighted row without leaving the popup:
#   enter → open/focus that space (reuses a live workspace, never duplicates)
#   N     → new worktree for that row's repo (pick an existing branch or type a
#           new one; the workspace is labelled "repo · branch")
#   D     → dismiss that space (worktree: remove the checkout, keep the branch;
#           repo: close the Herdr workspace, files on disk untouched)
#
# Runs inside a herdr popup, so fzf/read get a real tty. A repo and its
# worktrees are "the same kind of thing" here: rows you jump to, spin up, or
# tear down. Typing filters (repo names are lowercase); N/D are Shift so they
# never collide with the query.

set -uo pipefail

repos="${HERDR_REPOS:-$HOME/dev}"
sep=' · '   # repo/branch separator baked into every worktree's workspace label

now=$EPOCHSECONDS   # single clock read (bash builtin, no fork) for relative ages

# Tokyo Night cells for the list rows (fzf --ansi renders these).
C_NAME=$'\033[38;2;192;202;245m'   # subject/name        (#c0caf5)
C_DIM=$'\033[38;2;86;95;137m'      # muted meta / age    (#565f89)
C_BR=$'\033[38;2;122;162;247m'     # branch              (#7aa2f7)
C_LIVE=$'\033[38;2;158;206;154m'   # live glyph          (#9ece6a)
C_RST=$'\033[0m'

# Compact "last active" age (2h, 3d, 1w, 5mo, 1y) from an epoch into $REL.
# Pure arithmetic -- no date(1) fork per row.
reltime() {
  local d v
  if [ "${1:-0}" = 0 ]; then REL=""; return; fi
  d=$(( now - $1 )); (( d < 0 )) && d=0
  if   (( d < 3600 ));     then v="$(( d / 60 ))m"
  elif (( d < 86400 ));    then v="$(( d / 3600 ))h"
  elif (( d < 604800 ));   then v="$(( d / 86400 ))d"
  elif (( d < 2592000 ));  then v="$(( d / 604800 ))w"
  elif (( d < 31536000 )); then v="$(( d / 2592000 ))mo"
  else                          v="$(( d / 31536000 ))y"
  fi
  REL="$v"
}

# --- live state: a single workspace-list call -------------------------------
# Herdr attaches a `.worktree` block to any git-resolved workspace (primary
# repos AND linked worktrees), with `.checkout_path` as the on-disk location and
# `.is_linked_worktree` telling the two apart. That path is the authoritative
# key for "is this exact directory already open, and in which workspace?".
# Some plain-repo workspaces expose no `.worktree` yet, so we also keep the set
# of open labels as a fallback for repos (labels are unique ~/dev basenames).
ws_json="$(herdr workspace list 2>/dev/null || printf '{}')"

# Fold the one workspace-list payload into two in-process lookup maps, so per-row
# open-state checks are O(1) bash array reads instead of an awk/jq fork apiece:
#   wsid_by_path  : an on-disk checkout_path -> its workspace_id (authoritative
#                   "is this exact directory open?" key)
#   wsid_by_label : a workspace label -> its workspace_id (fallback for plain-repo
#                   workspaces that expose no `.worktree` block; labels are unique
#                   ~/dev basenames)
declare -A wsid_by_path wsid_by_label
while IFS=$'\t' read -r path id; do
  [ -n "$path" ] && wsid_by_path["$path"]="$id"
done < <(jq -r '.result.workspaces[]? | select(.worktree != null)
  | [.worktree.checkout_path, .workspace_id] | @tsv' <<<"$ws_json")
while IFS=$'\t' read -r label id; do
  [ -n "$label" ] && wsid_by_label["$label"]="$id"
done < <(jq -r '.result.workspaces[]? | [.label, .workspace_id] | @tsv' <<<"$ws_json")

# --- shared fzf look --------------------------------------------------------
# NB: override the user's global FZF_DEFAULT_OPTS (which sets --height 50% plus
# outer margin/padding) so the palette fills its whole herdr popup instead of
# rendering at half height with a dead band below. confirm()/the branch picker
# re-set --height afterwards, so their explicit values still win.
fzf_theme=(
  --height=100% --margin=0 --padding=0
  --ansi --layout=reverse --border=rounded --info=inline-right
  --highlight-line --no-scrollbar --pointer='▶'
  --bind 'ctrl-j:down,ctrl-k:up'
  --color='fg:#c0caf5,bg:-1,hl:#bb9af7,fg+:#c0caf5,bg+:#283457,hl+:#7dcfff'
  --color='info:#7aa2f7,border:#3b4261,label:#7aa2f7,gutter:-1'
  --color='prompt:#7dcfff,pointer:#7dcfff,marker:#9ece6a,header:#9ece6a'
)

confirm() { [ "$(printf 'no\nyes\n' | fzf "${fzf_theme[@]}" --height=6 --info=hidden --prompt="$1 ")" = "yes" ]; }

# --- commit-history preview -------------------------------------------------
# A real graph view rather than a flat oneline list, tuned to the Tokyo Night
# palette so it reads as a visualization: cyan hashes, blue ref decorations, a
# dimmed "· <relative age> · <author>" trailer, and the graph rail on the left.
# Field {5} (target_path) is substituted by fzf; falls back to a dir listing.
#
# ctrl-g toggles a scope flag: absent = the row's branch only; present = --all,
# showing every ref's topology (merges/siblings). The flag file is created and
# torn down inside the popup lifetime.
gitall_flag="$(mktemp -u "${TMPDIR:-/tmp}/herdr-go-gitall.XXXXXX")"
trap 'rm -f "$gitall_flag"' EXIT
# $gitall_flag is spliced in now; $all is deliberately left unexpanded so fzf's
# preview shell evaluates it per-refresh (SC2016 is a false positive here).
# shellcheck disable=SC2016
preview_cmd='
  if git -C {5} rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    [ -e "'"$gitall_flag"'" ] && all=--all || all=
    git -C {5} -c color.ui=always log --graph --decorate $all --color=always \
      --format="%C(#7dcfff)%h%C(reset)%C(#7aa2f7)%d%C(reset) %s %C(#565f89)· %ar · %an%C(reset)" \
      -30
  else
    ls -la {5} 2>/dev/null
  fi
'
gitall_bind="ctrl-g:execute-silent(if [ -e '$gitall_flag' ]; then rm -f '$gitall_flag'; else : > '$gitall_flag'; fi)+refresh-preview"

# --- rows: each repo (recency-sorted) followed by its worktrees --------------
# field1 = display cell (colored: glyph + name + last-active age + branch) shown;
#          the rest are hidden state used after selection.
# field2 = kind  repo|wt
# field3 = repo_name
# field4 = repo_path        (primary checkout — a safe cwd for git operations)
# field5 = target_path      (repo dir for a repo row; checkout dir for a wt row)
# field6 = branch           (wt rows only)
# field7 = open_wsid        (empty when the space is not currently open)
emit_repo() {
  local dir="$1" t="${2:-0}" repo glyph gcol wsid wt_dir head_ref branch age namep agep cell
  repo="${dir##*/}"                              # basename without a fork
  wsid="${wsid_by_path[$dir]:-}"
  [ -z "$wsid" ] && wsid="${wsid_by_label[$repo]:-}"
  if [ -n "$wsid" ]; then glyph='●'; gcol="$C_LIVE"; else glyph='○'; gcol="$C_DIM"; fi

  # Current branch straight from .git/HEAD (a plain read, no git fork). A raw sha
  # means detached HEAD -> show the short sha instead of a branch name.
  branch=""
  if [ -f "$dir/.git/HEAD" ] && read -r head_ref < "$dir/.git/HEAD"; then
    case "$head_ref" in
      "ref: refs/heads/"*) branch="${head_ref#ref: refs/heads/}" ;;
      ?*)                  branch="${head_ref:0:7}" ;;
    esac
  fi

  reltime "$t"; age="$REL"
  printf -v namep '%-22s' "$repo"
  printf -v agep '%4s' "$age"
  printf -v cell '%s%s%s  %s%s%s  %s%s%s  %s%s%s' \
    "$gcol" "$glyph" "$C_RST" "$C_NAME" "$namep" "$C_RST" \
    "$C_DIM" "$agep" "$C_RST" "$C_BR" "$branch" "$C_RST"
  printf '%s\trepo\t%s\t%s\t%s\t\t%s\n' "$cell" "$repo" "$dir" "$dir" "$wsid"

  # Linked worktrees only exist once git has recorded them under .git/worktrees/.
  # For the common no-worktree repo there is nothing to enumerate, so skip the
  # git spawn entirely -- that spawn was the bulk of the palette's startup cost.
  # NB: use a plain glob, not `compgen -G` -- compgen is absent from this
  # non-interactive bash build, so it would silently skip *every* worktree.
  local wts
  wt_dir="$dir/.git/worktrees"
  wts=("$wt_dir"/*)                              # unmatched glob stays literal
  [ -e "${wts[0]}" ] || return 0

  # Linked worktrees for this repo, straight from git (fast, local, authoritative).
  git -C "$dir" worktree list --porcelain 2>/dev/null \
    | awk '
        /^worktree /            { p = substr($0, 10) }
        /^branch /              { b = substr($0, 8); sub("refs/heads/", "", b); print p "\t" b }
        /^detached/             { print p "\t(detached)" }
      ' \
    | while IFS=$'\t' read -r wpath wbranch; do
        [ "$wpath" = "$dir" ] && continue        # the primary checkout is the repo row itself
        local wwsid wglyph wgcol wnamep wcell
        wwsid="${wsid_by_path[$wpath]:-}"
        if [ -n "$wwsid" ]; then wglyph='●'; wgcol="$C_LIVE"; else wglyph='○'; wgcol="$C_DIM"; fi
        # Worktree rows are indented under their repo; the branch is the name.
        printf -v wnamep '%-22s' "$wbranch"
        printf -v wcell '    %s%s%s  %s%s%s' \
          "$wgcol" "$wglyph" "$C_RST" "$C_BR" "$wnamep" "$C_RST"
        printf '%s\twt\t%s\t%s\t%s\t%s\t%s\n' \
          "$wcell" "$repo" "$dir" "$wpath" "$wbranch" "$wwsid"
      done
}

# Repos under the root (excluding the worktree pool), ordered by my most recent
# local git activity: reflog (.git/logs/HEAD) mtime tracks "where was I last"
# better than commit dates; fall back to .git's mtime.
rows="$(
  find "$repos" -mindepth 1 -maxdepth 1 -type d ! -name worktrees 2>/dev/null \
    | while IFS= read -r dir; do
        [ -e "$dir/.git" ] || continue
        if [ -f "$dir/.git/logs/HEAD" ]; then
          t="$(stat -c %Y "$dir/.git/logs/HEAD" 2>/dev/null)"
        else
          t="$(stat -c %Y "$dir/.git" 2>/dev/null)"
        fi
        printf '%s\t%s\n' "${t:-0}" "$dir"
      done \
    | sort -rn -k1,1 \
    | while IFS=$'\t' read -r t dir; do emit_repo "$dir" "$t"; done
)"

if [ -z "$rows" ]; then
  printf 'no git repos under %s\n' "$repos"
  sleep 1.5
  exit 0
fi

out="$(
  printf '%s\n' "$rows" \
    | fzf "${fzf_theme[@]}" \
        --delimiter='\t' --with-nth=1 \
        --prompt='go ❯ ' \
        --list-label=' repos · worktrees ' \
        --header='enter: open · N: new worktree · D: delete space · ● live ○ on disk · ctrl-/: preview · ctrl-g: all branches' \
        --expect=N,D \
        --bind 'ctrl-/:toggle-preview' \
        --bind "$gitall_bind" \
        --preview "$preview_cmd" \
        --preview-label ' history ' \
        --preview-window 'right,55%,border-left,nowrap'
)" || exit 0

key="$(head -1 <<<"$out")"       # the pressed --expect key (empty on plain Enter)
sel="$(sed -n '2p' <<<"$out")"   # the chosen row (all hidden fields intact)
[ -n "$sel" ] || exit 0

kind="$(cut -f2 <<<"$sel")"
repo="$(cut -f3 <<<"$sel")"
repo_path="$(cut -f4 <<<"$sel")"
target="$(cut -f5 <<<"$sel")"
branch="$(cut -f6 <<<"$sel")"
wsid="$(cut -f7 <<<"$sel")"

case "$key" in
  N)
    # New worktree for this row's repo. Offer branches that exist but aren't
    # checked out anywhere; typing a fresh name creates a new branch.
    checked="$(git -C "$repo_path" worktree list --porcelain 2>/dev/null \
      | awk '/^branch /{ b=substr($0,8); sub("refs/heads/","",b); print b }' | sort)"
    avail="$(comm -23 \
      <(git -C "$repo_path" for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null | sort) \
      <(printf '%s\n' "$checked"))"
    # fzf exit codes: 0 = picked an existing branch; 1 = accepted a typed query
    # that matched nothing (a BRAND-NEW branch name -- still emitted first via
    # --print-query); 130 = Esc; 2 = error. The old `|| exit 0` treated the
    # new-branch case (1) as an abort, so typing a fresh branch created nothing.
    if name="$(
      printf '%s\n' "$avail" \
        | fzf "${fzf_theme[@]}" --print-query --height=60% \
            --prompt="worktree ❯ " \
            --list-label=" new worktree · $repo " \
            --header='type a new branch and press enter, or pick an existing branch'
      )"; then rc=0; else rc=$?; fi
    case $rc in 0|1) ;; *) exit 0 ;; esac
    name="$(tail -1 <<<"$name")"   # last line = the picked branch, or the typed query
    [ -n "$name" ] || exit 0
    # `worktree create --branch` handles both: it checks out an existing branch
    # or creates a new one. (`worktree open --branch` only reopens an existing
    # checkout, so it's the wrong tool here.)
    herdr worktree create --cwd "$repo_path" --branch "$name" --label "$repo$sep$name" --focus >/dev/null
    ;;

  D)
    if [ "$kind" = "wt" ]; then
      confirm "delete worktree $(basename "$target")? (branch kept)" || exit 0
      if [ -n "$wsid" ]; then
        herdr worktree remove --workspace "$wsid" --force >/dev/null
      else
        git -C "$repo_path" worktree remove --force "$target" >/dev/null
      fi
    else
      # A repo row: "delete the space" = close the Herdr workspace, never the
      # files. No-op with a hint if the repo isn't currently open.
      if [ -z "$wsid" ]; then
        printf '%s is not open — nothing to close\n' "$repo"; sleep 1.2; exit 0
      fi
      confirm "close workspace $repo? (files kept on disk)" || exit 0
      if ! err="$(herdr workspace close "$wsid" 2>&1)"; then
        # Herdr refuses to close a repo that still has open worktree workspaces
        # unless we opt into closing the whole group.
        if printf '%s' "$err" | grep -qi 'group'; then
          confirm "$repo has open worktrees — close them too?" || exit 0
          herdr workspace close "$wsid" --group >/dev/null
        else
          printf '%s\n' "$err"; sleep 2; exit 1
        fi
      fi
    fi
    ;;

  *)
    # Enter: open or focus the highlighted space.
    if [ -n "$wsid" ]; then
      herdr workspace focus "$wsid" >/dev/null
    elif [ "$kind" = "wt" ]; then
      # On-disk-but-closed worktree: reopen by its exact path.
      herdr worktree open --cwd "$repo_path" --path "$target" --label "$repo$sep$branch" --focus >/dev/null
    else
      herdr workspace create --cwd "$repo_path" --label "$repo" --focus >/dev/null
    fi
    ;;
esac
