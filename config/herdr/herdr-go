# shellcheck shell=bash
# Space navigator (Herdr popup, prefix+space).
#
# writeShellApplication wraps this with set -euo pipefail — a false test or
# cancelled fzf must not abort the process, or the popup just vanishes.
#
#   enter  focus a live workspace, or open one (never duplicates)
#   N      herdr worktree create for that row's repo, labelled "repo · branch"
#   R      rename the row's live workspace
#   D      live worktree: herdr worktree remove (branch kept)
#          closed or missing worktree: git worktree remove (prunes it)
#          repo: herdr workspace close (files kept)
#          agent working → type yes
#
# N/R/D are Shift so they never collide with the lowercase filter query.
#
# Only directories with a real .git/ are repos. Linked worktrees (.git file)
# are listed under their repo wherever they live, never as repos themselves.
# Workspaces labelled "repo · <branch>" are re-labelled when the checkout has
# switched branch; any other label is left alone.

set -euo pipefail

repos="${HERDR_REPOS:-$HOME/dev}"
sep=' · '
us=$'\x1f'
now=$EPOCHSECONDS
visited_file="${XDG_CACHE_HOME:-$HOME/.cache}/herdr-go/visited"

C_NAME=$'\033[38;2;192;202;245m'
C_DIM=$'\033[38;2;86;95;137m'
C_BR=$'\033[38;2;122;162;247m'
C_LIVE=$'\033[38;2;158;206;154m'
C_WORK=$'\033[38;2;224;175;104m'
C_BLOCK=$'\033[38;2;247;118;142m'
C_RST=$'\033[0m'

# Herdr's server inherits the login shell. FZF_DEFAULT_OPTS (--height 50%,
# margin, padding) plus FZF_DEFAULT_COMMAND=fd will wreck a 55% popup.
export FZF_DEFAULT_OPTS=""
export FZF_DEFAULT_COMMAND=""
fzf_theme=(
  --height=100% --margin=0 --padding=0 --sync
  --ansi --layout=reverse --border=rounded --info=inline-right
  --highlight-line --no-scrollbar --pointer='▶' --no-preview
  --bind 'ctrl-j:down,ctrl-k:up'
  --color='fg:#c0caf5,bg:-1,hl:#bb9af7,fg+:#c0caf5,bg+:#283457,hl+:#7dcfff'
  --color='info:#7aa2f7,border:#3b4261,label:#7aa2f7,gutter:-1'
  --color='prompt:#7dcfff,pointer:#7dcfff,marker:#9ece6a,header:#9ece6a'
)

# TSV: field 1 is the fzf cell; the rest is hidden.
#   1 cell | 2 kind=repo|wt | 3 repo | 4 repo_path | 5 target | 6 branch
#   7 wsid | 8 stale=1 when the checkout directory is gone

reltime() {
  local d v
  if [ "${1:-0}" = 0 ]; then REL=""; return 0; fi
  d=$((now - $1))
  if ((d < 0)); then d=0; fi
  if   ((d < 60));       then v="<1m"
  elif ((d < 3600));     then v="$((d / 60))m"
  elif ((d < 86400));    then v="$((d / 3600))h"
  elif ((d < 604800));   then v="$((d / 86400))d"
  elif ((d < 2592000));  then v="$((d / 604800))w"
  elif ((d < 31536000)); then v="$((d / 2592000))mo"
  else                        v="$((d / 31536000))y"
  fi
  REL="$v"
}

confirm() {
  local ans=""
  ans="$(printf 'no\nyes\n' | fzf "${fzf_theme[@]}" --height=6 --info=hidden --prompt="$1 ")" || return 1
  [ "$ans" = "yes" ]
}

confirm_typed() {
  local out=""
  out="$(fzf "${fzf_theme[@]}" --print-query --height=6 --info=hidden \
    --prompt="$1 " --header='type yes to confirm' </dev/null)" || return 1
  [ "${out##*$'\n'}" = "yes" ]
}

# The popup closes as soon as the script exits; hold messages until a key.
fail() {
  printf '%s%s%s\n' "$C_BLOCK" "$1" "$C_RST"
  read -rsn1 -t 6 || true
}

error_code() {
  jq -r '.error.code // empty' <<<"$1" 2>/dev/null || true
}

error_message() {
  local msg=""
  msg="$(jq -r '.error.message // empty' <<<"$1" 2>/dev/null || true)"
  printf '%s' "${msg:-$1}"
}

herdr_do() {
  local out=""
  if out="$(herdr "$@" 2>&1)"; then return 0; fi
  fail "$(error_message "$out")"
  return 1
}

head_branch() {
  local ref=""
  if [ -f "$1/.git/HEAD" ] && read -r ref < "$1/.git/HEAD"; then
    case "$ref" in
      "ref: refs/heads/"*) printf '%s' "${ref#ref: refs/heads/}" ;;
      ?*)                  printf '%s' "${ref:0:7}" ;;
    esac
  fi
  return 0
}

is_dirty() {
  git -C "$1" status --porcelain=v1 2>/dev/null | awk 'BEGIN{e=1} NF{e=0; exit} END{exit e}'
}

agent_of() {
  local id="${1:-}"
  if [ -n "$id" ]; then printf '%s' "${agent_by_wsid[$id]:-}"; fi
  return 0
}

# --- herdr live state -------------------------------------------------------

declare -A wsid_by_path wsid_by_label agent_by_wsid label_by_wsid
focus_path=""
focus_label=""

load_workspaces() {
  local id label status path focused json
  json="$(herdr workspace list 2>/dev/null || printf '{}')"
  while IFS=$'\t' read -r id label status path focused || [ -n "${id:-}" ]; do
    [ -n "${id:-}" ] || continue
    agent_by_wsid["$id"]="$status"
    label_by_wsid["$id"]="$label"
    [ -n "$label" ] && wsid_by_label["$label"]="$id"
    [ -n "$path" ] && wsid_by_path["$path"]="$id"
    if [ "${focused:-0}" = 1 ]; then
      focus_path="$path"
      focus_label="$label"
    fi
  done < <(jq -r '.result.workspaces[]? | [
      .workspace_id,
      .label,
      .agent_status,
      (.worktree.checkout_path // ""),
      (if .focused then 1 else 0 end)
    ] | @tsv' <<<"$json" 2>/dev/null || true)
  if [ -z "$focus_path" ]; then
    case "$focus_label" in
      ""|*"$sep"*) ;;
      *) [ -d "$repos/$focus_label/.git" ] && focus_path="$repos/$focus_label" ;;
    esac
  fi
}

wsid_of() {
  local path="$1" name="$2" id=""
  id="${wsid_by_path[$path]:-}"
  if [ -n "$id" ]; then printf '%s' "$id"; return 0; fi
  printf '%s' "${wsid_by_label[$name]:-}"
  return 0
}

# --- visit clock ------------------------------------------------------------
# Herdr has no last-focused timestamp. Persist on Enter only; bump the focused
# path in memory so this popup sorts it to the top without a disk write.

declare -A visited

load_visited() {
  local path t
  [ -f "$visited_file" ] || return 0
  while IFS=$'\t' read -r path t || [ -n "${path:-}" ]; do
    [ -n "${path:-}" ] && [ -n "${t:-}" ] && visited["$path"]="$t"
  done < "$visited_file"
}

save_visited() {
  local tmp path
  if ((${#visited[@]} == 0)); then return 0; fi
  mkdir -p "$(dirname "$visited_file")"
  tmp="$(mktemp "$visited_file.XXXXXX")"
  for path in "${!visited[@]}"; do
    printf '%s\t%s\n' "$path" "${visited[$path]}"
  done > "$tmp"
  mv "$tmp" "$visited_file"
}

touch_visited() {
  [ -n "${1:-}" ] || return 0
  visited["$1"]="$EPOCHSECONDS"
  save_visited
}

# --- worktree cache ---------------------------------------------------------
# One list per repo that actually has linked checkouts, as US-separated rows
# (tab would collapse empty fields in read): path, branch, wsid, stale.
# The main checkout is dropped by flag, not path: git reports resolved paths.
# Herdr's open_workspace_id is authoritative; plain git is the fallback when
# Herdr can't answer (untrusted repo, server hiccup).

declare -A wt_rows

git_worktrees() {
  git -C "$1" worktree list --porcelain 2>/dev/null | awk -v us="$us" '
    function flush() { if (p != "" && n++) print p us b us us s; p = "" }
    /^worktree /  { flush(); p = substr($0, 10); b = ""; s = 0 }
    /^branch /    { b = substr($0, 8); sub(/^refs\/heads\//, "", b) }
    /^detached$/  { b = "(detached)" }
    /^prunable/   { s = 1 }
    END           { flush() }
  ' || true
}

cache_worktrees() {
  local dir="$1" json="" raw="" out="" wpath wbranch wsid stale
  [ -n "${wt_rows[$dir]+x}" ] && return 0
  if [ ! -d "$dir/.git/worktrees" ]; then
    wt_rows["$dir"]=""
    return 0
  fi
  json="$(herdr worktree list --cwd "$dir" 2>/dev/null || printf '{}')"
  if jq -e '.result.worktrees | type == "array"' <<<"$json" >/dev/null 2>&1; then
    raw="$(jq -r --arg us "$us" '
      .result.worktrees[] | select(.is_linked_worktree) | [
        (.path // ""),
        (if .is_detached then "(detached)" else (.branch // "") end),
        (.open_workspace_id // ""),
        (if .is_prunable then "1" else "0" end)
      ] | join($us)
    ' <<<"$json" 2>/dev/null || true)"
  else
    raw="$(git_worktrees "$dir")"
  fi
  while IFS="$us" read -r wpath wbranch wsid stale || [ -n "${wpath:-}" ]; do
    [ -n "${wpath:-}" ] && [ "$wpath" != "$dir" ] || continue
    [ -n "$wsid" ] || wsid="${wsid_by_path[$wpath]:-}"
    out+="$wpath$us$wbranch$us$wsid$us${stale:-0}"$'\n'
  done <<< "$raw"
  wt_rows["$dir"]="$out"
}

# Workspaces opened as "repo · branch" go stale when the checkout switches
# branch inside it; custom labels are not ours to touch.
sync_labels() {
  local dir repo wpath wbranch wsid _stale label want
  for dir in "${repo_dirs[@]}"; do
    repo="${dir##*/}"
    while IFS="$us" read -r wpath wbranch wsid _stale || [ -n "${wpath:-}" ]; do
      [ -n "${wpath:-}" ] && [ -n "${wsid:-}" ] || continue
      case "$wbranch" in ""|"(detached)") continue ;; esac
      label="${label_by_wsid[$wsid]:-}"
      want="$repo$sep$wbranch"
      case "$label" in "$repo$sep"*) ;; *) continue ;; esac
      [ "$label" != "$want" ] || continue
      if herdr workspace rename "$wsid" "$want" >/dev/null 2>&1; then
        label_by_wsid["$wsid"]="$want"
      fi
    done <<< "${wt_rows[$dir]:-}"
  done
}

group_key() {
  local dir="$1" repo="${1##*/}" live=0 visit t wpath wsid
  visit="${visited[$dir]:-0}"
  if [ -n "$(wsid_of "$dir" "$repo")" ]; then live=1; fi
  while IFS="$us" read -r wpath _ wsid _ || [ -n "${wpath:-}" ]; do
    [ -n "${wpath:-}" ] || continue
    if [ -n "$wsid" ]; then live=1; fi
    t="${visited[$wpath]:-0}"
    if [ "$t" -gt "$visit" ]; then visit=$t; fi
  done <<< "${wt_rows[$dir]:-}"
  printf '%s\t%s\t%s\n' "$live" "$visit" "$dir"
}

# --- row style & emit -------------------------------------------------------

style_space() {
  local path="$1" wsid="$2"
  glyph='○'; gcol="$C_DIM"; agent=""; acol=""; here=0
  if [ -n "$path" ] && [ "$path" = "${focus_path:-}" ]; then here=1; fi
  if [ -z "$wsid" ]; then return 0; fi
  glyph='●'; gcol="$C_LIVE"
  case "$(agent_of "$wsid")" in
    blocked) agent="blocked"; acol="$C_BLOCK"; gcol="$C_BLOCK" ;;
    working) agent="working"; acol="$C_WORK";  gcol="$C_WORK"  ;;
    done)    agent="done";    acol="$C_LIVE";  gcol="$C_LIVE"  ;;
  esac
  return 0
}

emit_worktree() {
  local dir="$1" repo="$2" wpath="$3" wbranch="$4" wsid="$5" stale="$6"
  local glyph gcol agent acol here live visit cell meta=""
  style_space "$wpath" "$wsid"
  if [ "$stale" = 1 ]; then
    glyph='✗'; gcol="$C_BLOCK"
    printf -v meta '  %s%s%s' "$C_BLOCK" "missing" "$C_RST"
  fi
  live=0
  if [ -n "$wsid" ]; then live=1; fi
  visit="${visited[$wpath]:-0}"
  if [ "$here" -eq 1 ]; then printf -v meta '%s  %s%s%s' "$meta" "$C_DIM" "here" "$C_RST"; fi
  if [ -n "$agent" ]; then printf -v meta '%s  %s%s%s' "$meta" "$acol" "$agent" "$C_RST"; fi
  printf -v cell '    %s%s%s  %s%s%s%s%s%s%s%s' \
    "$gcol" "$glyph" "$C_RST" \
    "$C_DIM" "$repo" "$sep" "$C_RST" \
    "$C_BR" "$wbranch" "$C_RST" "$meta"
  printf '%s\t%s\t%s\twt\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$live" "$visit" "$cell" "$repo" "$dir" "$wpath" "$wbranch" "$wsid" "$stale"
}

emit_repo() {
  local dir="$1" t="${2:-0}" repo wsid branch age namep agep cell meta=""
  local glyph gcol agent acol here wpath wbranch wwsid wstale
  repo="${dir##*/}"
  wsid="$(wsid_of "$dir" "$repo")"
  branch="$(head_branch "$dir")"
  style_space "$dir" "$wsid"
  if [ "$here" -eq 1 ]; then age="here"; else reltime "$t"; age="$REL"; fi
  if [ -n "$agent" ]; then printf -v meta '  %s%s%s' "$acol" "$agent" "$C_RST"; fi
  printf -v namep '%-22s' "$repo"
  printf -v agep '%4s' "$age"
  printf -v cell '%s%s%s  %s%s%s  %s%s%s  %s%s%s%s' \
    "$gcol" "$glyph" "$C_RST" "$C_NAME" "$namep" "$C_RST" \
    "$C_DIM" "$agep" "$C_RST" "$C_BR" "$branch" "$C_RST" "$meta"
  printf '%s\trepo\t%s\t%s\t%s\t\t%s\t0\n' "$cell" "$repo" "$dir" "$dir" "$wsid"

  if [ -z "${wt_rows[$dir]:-}" ]; then return 0; fi
  while IFS="$us" read -r wpath wbranch wwsid wstale || [ -n "${wpath:-}" ]; do
    [ -n "${wpath:-}" ] || continue
    emit_worktree "$dir" "$repo" "$wpath" "$wbranch" "$wwsid" "${wstale:-0}"
  done <<< "${wt_rows[$dir]}" \
    | sort -t $'\t' -k1,1nr -k2,2nr \
    | cut -f3- || true
}

each_repo() {
  local dir
  shopt -s nullglob
  for dir in "$repos"/*; do
    [ -d "$dir/.git" ] || continue
    [ "${dir##*/}" = worktrees ] && continue
    printf '%s\n' "$dir"
  done
  shopt -u nullglob
}

# --- actions ----------------------------------------------------------------

risk_prompt() {
  local action="$1" subject="$2" keep="$3" path="$4" id="$5" check_dirty="${6:-0}" hints="" st
  if [ "$path" = "${focus_path:-}" ]; then hints="you're in it"; fi
  st="$(agent_of "$id")"
  case "$st" in
    blocked) hints="${hints:+$hints, }agent blocked" ;;
    working) hints="${hints:+$hints, }agent working" ;;
  esac
  if [ "$check_dirty" = 1 ] && [ -n "$path" ] && is_dirty "$path"; then
    hints="${hints:+$hints, }uncommitted changes"
  fi
  if [ -n "$hints" ]; then
    printf '%s %s? %s (%s)' "$action" "$subject" "$hints" "$keep"
  else
    printf '%s %s? (%s)' "$action" "$subject" "$keep"
  fi
}

dismiss_confirm() {
  local id="$1" prompt="$2"
  if [ "$(agent_of "$id")" = "working" ]; then
    confirm_typed "$prompt"
  else
    confirm "$prompt"
  fi
}

available_branches() {
  local repo_path="$1" checked
  checked="$(
    {
      head_branch "$repo_path"
      printf '\n'
      awk -F "$us" '$2 != "" && $2 != "(detached)" { print $2 }' <<< "${wt_rows[$repo_path]:-}"
    } | awk 'NF && !seen[$0]++'
  )"
  git -C "$repo_path" for-each-ref --sort=-committerdate --format='%(refname)' \
    refs/heads refs/remotes/origin 2>/dev/null \
  | awk -v checked="$checked" '
      BEGIN { n=split(checked, a, "\n"); for (i=1;i<=n;i++) if (a[i]!="") skip[a[i]]=1 }
      $0=="refs/remotes/origin/HEAD" { next }
      {
        short=$0
        sub(/^refs\/heads\//, "", short)
        sub(/^refs\/remotes\/origin\//, "", short)
        if (short=="" || short in seen || short in skip) next
        seen[short]=1
        print short
      }
    ' || true
}

create_worktree() {
  local repo_path="$1" repo="$2" branch="$3"
  local extra=()
  if git -C "$repo_path" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    extra=(--base "origin/$branch")
  fi
  herdr_do worktree create --cwd "$repo_path" --branch "$branch" "${extra[@]}" \
    --label "$repo$sep$branch" --focus
}

new_worktree() {
  local repo_path="$1" repo="$2" query="$3" avail name="" rc=0
  local n_query=()
  avail="$(available_branches "$repo_path")"
  case "$query" in */*) n_query=(--query="$query") ;; esac
  # 0 = picked a row; 1 = typed a new name (--print-query); 130 = Esc.
  if [ -n "$avail" ]; then
    name="$(printf '%s\n' "$avail" | fzf "${fzf_theme[@]}" --print-query --height=60% \
      "${n_query[@]}" \
      --prompt="worktree ❯ " \
      --list-label=" new worktree · $repo " \
      --header='type a new branch, or pick one — newest first')" || rc=$?
  else
    name="$(fzf "${fzf_theme[@]}" --print-query --height=60% \
      "${n_query[@]}" \
      --prompt="worktree ❯ " \
      --list-label=" new worktree · $repo " \
      --header='type a new branch' </dev/null)" || rc=$?
  fi
  case $rc in 0|1) ;; *) return 0 ;; esac
  name="${name##*$'\n'}"
  [ -n "$name" ] || return 0
  create_worktree "$repo_path" "$repo" "$name"
}

rename_space() {
  local repo="$1" wsid="$2" cur out="" rc=0 name
  if [ -z "$wsid" ]; then
    fail "$repo is not open — nothing to rename"
    return 0
  fi
  cur="${label_by_wsid[$wsid]:-}"
  out="$(fzf "${fzf_theme[@]}" --print-query --height=6 --info=hidden \
    --prompt='rename ❯ ' --query="$cur" \
    --header='enter saves · esc cancels' </dev/null)" || rc=$?
  case $rc in 0|1) ;; *) return 0 ;; esac
  name="${out##*$'\n'}"
  if [ -z "$name" ] || [ "$name" = "$cur" ]; then return 0; fi
  herdr_do workspace rename "$wsid" "$name"
}

dismiss_space() {
  local kind="$1" repo="$2" repo_path="$3" target="$4" branch="$5" wsid="$6" stale="$7"
  local prompt err keep='branch kept'
  if [ "$kind" = "wt" ]; then
    if [ "$stale" = 1 ]; then keep='checkout already gone, branch kept'; fi
    prompt="$(risk_prompt 'delete worktree' "${branch:-${target##*/}}" "$keep" "$target" "$wsid" 0)"
    dismiss_confirm "$wsid" "$prompt" || return 0
    if [ -n "$wsid" ]; then
      herdr_do worktree remove --workspace "$wsid" --force
    elif ! err="$(git -C "$repo_path" worktree remove --force "$target" 2>&1)"; then
      fail "$err"
      return 1
    fi
    return 0
  fi
  if [ -z "$wsid" ]; then
    fail "$repo is not open — nothing to close"
    return 0
  fi
  prompt="$(risk_prompt 'close' "$repo" 'files kept' "$target" "$wsid" 1)"
  dismiss_confirm "$wsid" "$prompt" || return 0
  if err="$(herdr workspace close "$wsid" 2>&1)"; then
    return 0
  fi
  if [ "$(error_code "$err")" = "workspace_group_close_required" ]; then
    confirm "$repo has open worktrees — close them too?" || return 0
    herdr_do workspace close "$wsid" --group
  else
    fail "$(error_message "$err")"
    return 1
  fi
}

open_space() {
  local kind="$1" repo="$2" repo_path="$3" target="$4" branch="$5" wsid="$6" stale="$7"
  if [ -z "$wsid" ] && [ "$stale" = 1 ]; then
    fail "${target} no longer exists — D prunes it"
    return 0
  fi
  touch_visited "$target"
  if [ -n "$wsid" ]; then
    herdr_do workspace focus "$wsid"
  elif [ "$kind" = "wt" ]; then
    herdr_do worktree open --cwd "$repo_path" --path "$target" \
      --label "$repo$sep$branch" --focus
  else
    herdr_do workspace create --cwd "$repo_path" --label "$repo" --focus
  fi
}

# --- main -------------------------------------------------------------------

load_workspaces
load_visited
if [ -n "$focus_path" ]; then
  visited["$focus_path"]="$now"
fi

repo_dirs=()
while IFS= read -r dir || [ -n "${dir:-}" ]; do
  [ -n "${dir:-}" ] || continue
  repo_dirs+=("$dir")
  cache_worktrees "$dir"
done < <(each_repo)

if ((${#repo_dirs[@]} > 0)); then
  sync_labels
fi

rows=""
if ((${#repo_dirs[@]} > 0)); then
  rows="$(
    for dir in "${repo_dirs[@]}"; do
      group_key "$dir"
    done \
      | sort -t $'\t' -k1,1nr -k2,2nr -k3,3 \
      | while IFS=$'\t' read -r _live _visit dir || [ -n "${dir:-}" ]; do
          [ -n "${dir:-}" ] || continue
          emit_repo "$dir" "${visited[$dir]:-0}"
        done || true
  )" || rows=""
fi

if [ -z "$rows" ]; then
  fail "no git repos under $repos"
  exit 0
fi

start_pos=1
if [ -n "${focus_path:-}" ]; then
  n=0 cur=0
  while IFS=$'\t' read -r _cell _k _r _rp tgt _rest || [ -n "${tgt:-}" ]; do
    n=$((n + 1))
    if [ "${tgt:-}" = "$focus_path" ]; then cur=$n; fi
  done <<<"$rows"
  if [ "$cur" -gt 0 ] && [ "$n" -gt 1 ]; then
    if [ "$cur" -lt "$n" ]; then start_pos=$((cur + 1))
    else start_pos=$((cur - 1)); fi
  fi
fi

out=""
out="$(
  printf '%s\n' "$rows" \
    | fzf "${fzf_theme[@]}" \
        --delimiter='\t' --with-nth=1 --nth=1 --no-sort \
        --prompt='go ❯ ' \
        --list-label=' repos · worktrees ' \
        --header='enter: open · N: new worktree · R: rename · D: delete' \
        --expect=N,R,D --print-query \
        --bind "start:pos($start_pos)"
)" || exit 0

query="" key="" sel=""
{
  IFS= read -r query || true
  IFS= read -r key || true
  IFS= read -r sel || true
} <<<"$out"
[ -n "$sel" ] || exit 0

kind="$(cut -f2 <<<"$sel")"
repo="$(cut -f3 <<<"$sel")"
repo_path="$(cut -f4 <<<"$sel")"
target="$(cut -f5 <<<"$sel")"
branch="$(cut -f6 <<<"$sel")"
wsid="$(cut -f7 <<<"$sel")"
stale="$(cut -f8 <<<"$sel")"

case "$key" in
  N) new_worktree "$repo_path" "$repo" "$query" ;;
  R) rename_space "$repo" "$wsid" ;;
  D) dismiss_space "$kind" "$repo" "$repo_path" "$target" "$branch" "$wsid" "$stale" ;;
  *) open_space "$kind" "$repo" "$repo_path" "$target" "$branch" "$wsid" "$stale" ;;
esac
