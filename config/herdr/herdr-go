# shellcheck shell=bash
# Space navigator (Herdr popup, prefix+space).
#
# One list of every git repo under $HERDR_REPOS and its linked worktrees:
#   enter  open or focus the row (never duplicates a live workspace)
#   N      new worktree for that row's repo, labelled "repo · branch"
#   D      dismiss — worktree: drop the checkout (branch kept);
#          repo: close the Herdr workspace (files kept)
#
# N/D are Shift so they never collide with the lowercase filter query.

set -uo pipefail

repos="${HERDR_REPOS:-$HOME/dev}"
sep=' · '
now=$EPOCHSECONDS
visited_file="${XDG_CACHE_HOME:-$HOME/.cache}/herdr-go/visited"

# Tokyo Night cells (fzf --ansi).
C_NAME=$'\033[38;2;192;202;245m'   # #c0caf5
C_DIM=$'\033[38;2;86;95;137m'      # #565f89
C_BR=$'\033[38;2;122;162;247m'     # #7aa2f7
C_LIVE=$'\033[38;2;158;206;154m'   # #9ece6a
C_WORK=$'\033[38;2;224;175;104m'   # #e0af68
C_BLOCK=$'\033[38;2;247;118;142m'  # #f7768e
C_RST=$'\033[0m'

# Override FZF_DEFAULT_OPTS (--height 50%, margin) so the list fills the popup.
# confirm() and the branch picker re-set --height; those values still win.
fzf_theme=(
  --height=100% --margin=0 --padding=0
  --ansi --layout=reverse --border=rounded --info=inline-right
  --highlight-line --no-scrollbar --pointer='▶' --no-preview
  --bind 'ctrl-j:down,ctrl-k:up'
  --color='fg:#c0caf5,bg:-1,hl:#bb9af7,fg+:#c0caf5,bg+:#283457,hl+:#7dcfff'
  --color='info:#7aa2f7,border:#3b4261,label:#7aa2f7,gutter:-1'
  --color='prompt:#7dcfff,pointer:#7dcfff,marker:#9ece6a,header:#9ece6a'
)

# TSV row: field 1 is the fzf cell (--with-nth=1 --nth=1); the rest is hidden.
#   1 cell | 2 kind=repo|wt | 3 repo | 4 repo_path | 5 target | 6 branch | 7 wsid

# --- small helpers ----------------------------------------------------------

reltime() {
  # Compact age from epoch → $REL. No date(1).
  local d v
  if [ "${1:-0}" = 0 ]; then REL=""; return; fi
  d=$((now - $1)); ((d < 0)) && d=0
  if   ((d < 60));      then v="<1m"
  elif ((d < 3600));    then v="$((d / 60))m"
  elif ((d < 86400));   then v="$((d / 3600))h"
  elif ((d < 604800));  then v="$((d / 86400))d"
  elif ((d < 2592000)); then v="$((d / 604800))w"
  elif ((d < 31536000)); then v="$((d / 2592000))mo"
  else                        v="$((d / 31536000))y"
  fi
  REL="$v"
}

confirm() {
  [ "$(printf 'no\nyes\n' | fzf "${fzf_theme[@]}" --height=6 --info=hidden --prompt="$1 ")" = "yes" ]
}

head_branch() {
  # Branch from .git/HEAD (a read, no git fork). Detached → short sha.
  local ref=""
  if [ -f "$1/.git/HEAD" ] && read -r ref < "$1/.git/HEAD"; then
    case "$ref" in
      "ref: refs/heads/"*) printf '%s' "${ref#ref: refs/heads/}" ;;
      ?*)                  printf '%s' "${ref:0:7}" ;;
    esac
  fi
}

is_dirty() {
  git -C "$1" status --porcelain=v1 2>/dev/null | awk 'BEGIN{e=1} NF{e=0; exit} END{exit e}'
}

# --- herdr live state -------------------------------------------------------
# One workspace-list call. checkout_path is the open-or-not key; label is the
# fallback for workspaces that still ship no .worktree block.

declare -A wsid_by_path wsid_by_label agent_by_wsid
focus_path=""
focus_label=""

load_workspaces() {
  local id label status path focused
  local json
  json="$(herdr workspace list 2>/dev/null || printf '{}')"
  while IFS=$'\t' read -r id label status path focused; do
    [ -n "$id" ] && agent_by_wsid["$id"]="$status"
    [ -n "$label" ] && wsid_by_label["$label"]="$id"
    [ -n "$path" ] && wsid_by_path["$path"]="$id"
    if [ "$focused" = 1 ]; then
      focus_path="$path"
      focus_label="$label"
    fi
  done < <(jq -r '.result.workspaces[]? | [
      .workspace_id,
      .label,
      .agent_status,
      (.worktree.checkout_path // ""),
      (if .focused then 1 else 0 end)
    ] | @tsv' <<<"$json")
  # Plain-repo workspaces sometimes omit checkout_path; labels are ~/dev basenames.
  if [ -z "$focus_path" ]; then
    case "$focus_label" in
      ""|*"$sep"*) ;;
      *) [ -d "$repos/$focus_label" ] && focus_path="$repos/$focus_label" ;;
    esac
  fi
}

wsid_of() {
  local path="$1" name="$2" id
  id="${wsid_by_path[$path]:-}"
  [ -n "$id" ] && { printf '%s' "$id"; return; }
  printf '%s' "${wsid_by_label[$name]:-}"
}

# --- visit clock ------------------------------------------------------------
# Herdr has no last-focused timestamp. Persist one epoch per checkout and bump
# the focused space on open so sidebar / prefix-number visits count.

declare -A visited

load_visited() {
  local path t
  [ -f "$visited_file" ] || return 0
  while IFS=$'\t' read -r path t; do
    [ -n "$path" ] && [ -n "${t:-}" ] && visited["$path"]="$t"
  done < "$visited_file"
}

save_visited() {
  local tmp path
  ((${#visited[@]})) || return 0
  mkdir -p "$(dirname "$visited_file")"
  tmp="$(mktemp "$visited_file.XXXXXX")"
  for path in "${!visited[@]}"; do
    printf '%s\t%s\n' "$path" "${visited[$path]}"
  done > "$tmp"
  mv "$tmp" "$visited_file"
}

touch_visited() {
  [ -n "$1" ] || return 0
  visited["$1"]="$EPOCHSECONDS"
  save_visited
}

# --- worktree cache ---------------------------------------------------------
# porcelain once per repo; group sort and row emit share it. Filled in this
# shell so the emit subshell inherits the map (a `for | sort` pipe would not).

declare -A wt_porcelain

cache_worktrees() {
  local dir="$1"
  [ -n "${wt_porcelain[$dir]+x}" ] && return 0
  if [ -e "$dir/.git/worktrees" ]; then
    wt_porcelain["$dir"]="$(
      git -C "$dir" worktree list --porcelain 2>/dev/null | awk '
        /^worktree / { p = substr($0, 10) }
        /^branch /   { b = substr($0, 8); sub("refs/heads/", "", b); print p "\t" b }
        /^detached/  { print p "\t(detached)" }
      '
    )"
  else
    wt_porcelain["$dir"]=""
  fi
}

# live(0/1)  visit-epoch  dir — a group is live if any of its checkouts is open.
group_key() {
  local dir="$1" repo="${1##*/}" live=0 visit t wpath
  visit="${visited[$dir]:-0}"
  if [ -n "$(wsid_of "$dir" "$repo")" ]; then live=1; fi
  if [ -n "${wt_porcelain[$dir]}" ]; then
    while IFS=$'\t' read -r wpath _; do
      [ -n "$wpath" ] && [ "$wpath" != "$dir" ] || continue
      [ -n "${wsid_by_path[$wpath]:-}" ] && live=1
      t="${visited[$wpath]:-0}"
      [ "$t" -gt "$visit" ] && visit=$t
    done <<< "${wt_porcelain[$dir]}"
  fi
  printf '%s\t%s\t%s\n' "$live" "$visit" "$dir"
}

# --- row style & emit -------------------------------------------------------
# Agent badges come from workspace-list (free). git status is hundreds of ms
# on large checkouts, so dirty/ahead stay off the open path and only on D.

style_space() {
  # Sets glyph, gcol, agent, acol, here on the caller (bash dynamic scope).
  local path="$1" wsid="$2"
  glyph='○'; gcol="$C_DIM"; agent=""; acol=""; here=0
  [ -n "$path" ] && [ "$path" = "${focus_path:-}" ] && here=1
  [ -z "$wsid" ] && return 0
  glyph='●'; gcol="$C_LIVE"
  case "${agent_by_wsid[$wsid]:-}" in
    blocked) agent="blocked"; acol="$C_BLOCK"; gcol="$C_BLOCK" ;;
    working) agent="working"; acol="$C_WORK";  gcol="$C_WORK"  ;;
    "done")  agent="done";    acol="$C_LIVE";  gcol="$C_LIVE"  ;;
  esac
}

emit_repo() {
  local dir="$1" t="${2:-0}" repo wsid branch age namep agep cell meta
  local glyph gcol agent acol here
  repo="${dir##*/}"
  wsid="$(wsid_of "$dir" "$repo")"
  branch="$(head_branch "$dir")"
  style_space "$dir" "$wsid"
  if [ "$here" -eq 1 ]; then age="here"; else reltime "$t"; age="$REL"; fi
  meta=""
  [ -n "$agent" ] && printf -v meta '  %s%s%s' "$acol" "$agent" "$C_RST"
  printf -v namep '%-22s' "$repo"
  printf -v agep '%4s' "$age"
  printf -v cell '%s%s%s  %s%s%s  %s%s%s  %s%s%s%s' \
    "$gcol" "$glyph" "$C_RST" "$C_NAME" "$namep" "$C_RST" \
    "$C_DIM" "$agep" "$C_RST" "$C_BR" "$branch" "$C_RST" "$meta"
  printf '%s\trepo\t%s\t%s\t%s\t\t%s\n' "$cell" "$repo" "$dir" "$dir" "$wsid"

  [ -n "${wt_porcelain[$dir]}" ] || return 0
  printf '%s\n' "${wt_porcelain[$dir]}" \
    | while IFS=$'\t' read -r wpath wbranch; do
        [ "$wpath" = "$dir" ] && continue
        emit_worktree "$dir" "$repo" "$wpath" "$wbranch"
      done \
    | sort -t $'\t' -k1,1nr -k2,2nr \
    | cut -f3-
}

emit_worktree() {
  local dir="$1" repo="$2" wpath="$3" wbranch="$4"
  local wsid glyph gcol agent acol here live visit cell meta
  wsid="${wsid_by_path[$wpath]:-}"
  style_space "$wpath" "$wsid"
  live=0; [ -n "$wsid" ] && live=1
  visit="${visited[$wpath]:-0}"
  meta=""
  [ "$here" -eq 1 ] && printf -v meta '  %s%s%s' "$C_DIM" "here" "$C_RST"
  [ -n "$agent" ] && printf -v meta '%s  %s%s%s' "$meta" "$acol" "$agent" "$C_RST"
  # Always "repo · branch" in the cell. Filtering must not inject a parent
  # row — that would steal Enter from a unique worktree match.
  printf -v cell '    %s%s%s  %s%s%s%s%s%s%s%s' \
    "$gcol" "$glyph" "$C_RST" \
    "$C_DIM" "$repo" "$sep" "$C_RST" \
    "$C_BR" "$wbranch" "$C_RST" "$meta"
  printf '%s\t%s\t%s\twt\t%s\t%s\t%s\t%s\t%s\n' \
    "$live" "$visit" "$cell" "$repo" "$dir" "$wpath" "$wbranch" "$wsid"
}

each_repo() {
  local dir
  for dir in "$repos"/*; do
    [ -d "$dir" ] || continue
    [ "${dir##*/}" = worktrees ] && continue
    [ -e "$dir/.git" ] || continue
    printf '%s\n' "$dir"
  done
}

# --- actions ----------------------------------------------------------------

risk_prompt() {
  local action="$1" subject="$2" keep="$3" path="$4" id="$5" hints="" st
  [ "$path" = "${focus_path:-}" ] && hints="you're in it"
  st="${agent_by_wsid[${id:-}]:-}"
  case "$st" in
    blocked) hints="${hints:+$hints, }agent blocked" ;;
    working) hints="${hints:+$hints, }agent working" ;;
  esac
  if [ -n "$path" ] && is_dirty "$path"; then
    hints="${hints:+$hints, }uncommitted changes"
  fi
  if [ -n "$hints" ]; then
    printf '%s %s? %s (%s)' "$action" "$subject" "$hints" "$keep"
  else
    printf '%s %s? (%s)' "$action" "$subject" "$keep"
  fi
}

available_branches() {
  # Local + origin/* not checked out anywhere, newest first. No fetch.
  local repo_path="$1" checked
  checked="$(git -C "$repo_path" worktree list --porcelain 2>/dev/null \
    | awk '/^branch /{ b=substr($0,8); sub("refs/heads/","",b); print b }')"
  git -C "$repo_path" for-each-ref --sort=-committerdate --format='%(refname)' \
    refs/heads refs/remotes/origin 2>/dev/null \
  | awk -v checked="$checked" '
      BEGIN { n=split(checked, a, "\n"); for (i=1;i<=n;i++) if (a[i]!="") skip[a[i]]=1 }
      $0=="refs/remotes/origin/HEAD" { next }
      {
        short=$0
        sub(/^refs\/heads\//, "", short)
        sub(/^refs\/remotes\/origin\//, "", short)
        if (short=="" || short in seen || short in skip) next
        seen[short]=1
        print short
      }
    '
}

create_worktree() {
  local repo_path="$1" repo="$2" branch="$3"
  local extra=()
  if git -C "$repo_path" show-ref --verify --quiet "refs/heads/$branch"; then
    :
  elif git -C "$repo_path" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    extra=(--base "origin/$branch")
  fi
  herdr worktree create --cwd "$repo_path" --branch "$branch" "${extra[@]}" \
    --label "$repo$sep$branch" --focus >/dev/null
}

new_worktree() {
  local repo_path="$1" repo="$2" query="$3" avail name rc
  local n_query=()
  avail="$(available_branches "$repo_path")"
  case "$query" in */*) n_query=(--query="$query") ;; esac
  # fzf: 0 = picked a row; 1 = typed a new name (--print-query); 130 = Esc.
  if name="$(
    { [ -n "$avail" ] && printf '%s\n' "$avail"; } \
      | fzf "${fzf_theme[@]}" --print-query --height=60% \
          "${n_query[@]}" \
          --prompt="worktree ❯ " \
          --list-label=" new worktree · $repo " \
          --header='type a new branch, or pick one — newest first'
    )"; then rc=0; else rc=$?; fi
  case $rc in 0|1) ;; *) return 0 ;; esac
  name="${name##*$'\n'}"
  [ -n "$name" ] || return 0
  create_worktree "$repo_path" "$repo" "$name"
}

dismiss_space() {
  local kind="$1" repo="$2" repo_path="$3" target="$4" branch="$5" wsid="$6"
  if [ "$kind" = "wt" ]; then
    confirm "$(risk_prompt 'delete worktree' "${branch:-${target##*/}}" 'branch kept' "$target" "$wsid")" || return 0
    if [ -n "$wsid" ]; then
      herdr worktree remove --workspace "$wsid" --force >/dev/null
    else
      git -C "$repo_path" worktree remove --force "$target" >/dev/null
    fi
    return 0
  fi
  if [ -z "$wsid" ]; then
    printf '%s is not open — nothing to close\n' "$repo"
    sleep 1.2
    return 0
  fi
  confirm "$(risk_prompt 'close' "$repo" 'files kept' "$target" "$wsid")" || return 0
  local err
  if err="$(herdr workspace close "$wsid" 2>&1)"; then
    return 0
  fi
  if [[ "${err,,}" == *group* ]]; then
    confirm "$repo has open worktrees — close them too?" || return 0
    herdr workspace close "$wsid" --group >/dev/null
  else
    printf '%s\n' "$err"
    sleep 2
    exit 1
  fi
}

open_space() {
  local kind="$1" repo="$2" repo_path="$3" target="$4" branch="$5" wsid="$6"
  touch_visited "$target"
  if [ -n "$wsid" ]; then
    herdr workspace focus "$wsid" >/dev/null
  elif [ "$kind" = "wt" ]; then
    herdr worktree open --cwd "$repo_path" --path "$target" \
      --label "$repo$sep$branch" --focus >/dev/null
  else
    herdr workspace create --cwd "$repo_path" --label "$repo" --focus >/dev/null
  fi
}

# --- main -------------------------------------------------------------------

load_workspaces
load_visited
[ -n "$focus_path" ] && visited["$focus_path"]="$now"
save_visited

repo_dirs=()
while IFS= read -r dir; do
  repo_dirs+=("$dir")
  cache_worktrees "$dir"
done < <(each_repo)

rows="$(
  for dir in "${repo_dirs[@]}"; do
    group_key "$dir"
  done \
    | sort -t $'\t' -k1,1nr -k2,2nr -k3,3 \
    | while IFS=$'\t' read -r _live _visit dir; do
        emit_repo "$dir" "${visited[$dir]:-0}"
      done
)"

if [ -z "$rows" ]; then
  printf 'no git repos under %s\n' "$repos"
  sleep 1.5
  exit 0
fi

# Cursor on the previous space (tmux last-window), not the one we're in.
start_pos=1
if [ -n "${focus_path:-}" ]; then
  n=0 cur=0
  while IFS=$'\t' read -r _cell _k _r _rp tgt _rest; do
    n=$((n + 1))
    [ "$tgt" = "$focus_path" ] && cur=$n
  done <<<"$rows"
  if [ "$cur" -gt 0 ] && [ "$n" -gt 1 ]; then
    if [ "$cur" -lt "$n" ]; then start_pos=$((cur + 1))
    else start_pos=$((cur - 1)); fi
  fi
fi

out="$(
  printf '%s\n' "$rows" \
    | fzf "${fzf_theme[@]}" \
        --delimiter='\t' --with-nth=1 --nth=1 --no-sort \
        --prompt='go ❯ ' \
        --list-label=' repos · worktrees ' \
        --header='enter: open · N: new worktree · D: delete space · ● live ○ on disk' \
        --expect=N,D --print-query \
        --bind "start:pos($start_pos)"
)" || exit 0

{
  IFS= read -r query
  IFS= read -r key
  IFS= read -r sel
} <<<"$out"
[ -n "$sel" ] || exit 0

kind="$(cut -f2 <<<"$sel")"
repo="$(cut -f3 <<<"$sel")"
repo_path="$(cut -f4 <<<"$sel")"
target="$(cut -f5 <<<"$sel")"
branch="$(cut -f6 <<<"$sel")"
wsid="$(cut -f7 <<<"$sel")"

case "$key" in
  N) new_worktree "$repo_path" "$repo" "$query" ;;
  D) dismiss_space "$kind" "$repo" "$repo_path" "$target" "$branch" "$wsid" ;;
  *) open_space "$kind" "$repo" "$repo_path" "$target" "$branch" "$wsid" ;;
esac
