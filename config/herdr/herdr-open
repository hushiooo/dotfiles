# Command palette: fuzzy-pick a git repo under ~/dev and open it as a workspace,
# focusing an existing workspace of the same name instead of duplicating it.
# Runs inside a herdr popup, so fzf gets a real tty.
repos="${HERDR_REPOS:-$HOME/dev}"

# Labels of already-open workspaces, to mark repos that are live.
open_labels="$(herdr workspace list | jq -r '.result.workspaces[].label')"

# One row per git repo under the root (excluding the worktrees pool), ordered by
# my most recent local git activity: reflog (.git/logs/HEAD) mtime, which tracks
# "where was I last" better than commit dates. Falls back to .git's mtime.
rows="$(
  find "$repos" -mindepth 1 -maxdepth 1 -type d ! -name worktrees 2>/dev/null \
    | while IFS= read -r dir; do
        [ -e "$dir/.git" ] || continue
        if [ -f "$dir/.git/logs/HEAD" ]; then
          t="$(stat -c %Y "$dir/.git/logs/HEAD" 2>/dev/null)"
        else
          t="$(stat -c %Y "$dir/.git" 2>/dev/null)"
        fi
        printf '%s\t%s\n' "${t:-0}" "$dir"
      done \
    | sort -rn -k1,1 \
    | cut -f2- \
    | while IFS= read -r dir; do
        name="$(basename "$dir")"
        case $'\n'"$open_labels"$'\n' in
          *$'\n'"$name"$'\n'*) glyph="●" ;;
          *) glyph="○" ;;
        esac
        printf '%s %s\t%s\n' "$glyph" "$name" "$dir"
      done
)"

if [ -z "$rows" ]; then
  printf 'no git repos under %s\n' "$repos"
  sleep 1.5
  exit 0
fi

sel="$(
  printf '%s\n' "$rows" \
    | fzf \
      --ansi --layout=reverse --border=rounded --info=inline-right \
      --highlight-line --no-scrollbar --pointer='▶' --prompt='repo ❯ ' \
      --delimiter='\t' --with-nth=1 \
      --list-label=' open workspace ' \
      --header='enter: open · ● live · ○ on disk · ctrl-/ : preview' \
      --bind 'ctrl-j:down,ctrl-k:up,ctrl-/:toggle-preview' \
      --preview 'git -C {2} -c color.ui=always log --oneline --decorate -15 2>/dev/null || ls -la {2}' \
      --preview-window 'right,50%,border-left' \
      --color='fg:#c0caf5,bg:-1,hl:#bb9af7,fg+:#c0caf5,bg+:#283457,hl+:#7dcfff' \
      --color='info:#7aa2f7,border:#3b4261,label:#7aa2f7,gutter:-1' \
      --color='prompt:#7dcfff,pointer:#7dcfff,marker:#9ece6a,header:#9ece6a'
)" || exit 0
[ -n "$sel" ] || exit 0

dir="$(cut -f2 <<<"$sel")"
label="$(basename "$dir")"

# Reuse a workspace already opened under this label rather than duplicating it.
existing="$(
  herdr workspace list \
    | jq -r --arg l "$label" \
      'first(.result.workspaces[] | select(.label == $l) | .workspace_id) // empty'
)"

if [ -n "$existing" ]; then
  herdr workspace focus "$existing" >/dev/null
else
  herdr workspace create --cwd "$dir" --label "$label" --focus >/dev/null
fi
