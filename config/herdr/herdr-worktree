# Worktree hub for the current repo (one popup): Enter opens/focuses the selected
# worktree, Ctrl-X deletes it (after confirmation). Scoped to the focused
# workspace, which keybinding commands expose as HERDR_ACTIVE_WORKSPACE_ID.
ws="${HERDR_ACTIVE_WORKSPACE_ID:?herdr-worktree must run from a herdr keybinding}"

worktrees="$(herdr worktree list --workspace "$ws")"

# The primary checkout (a safe cwd from which to git-remove a closed worktree).
main_path="$(
  jq -r 'first(.result.worktrees[] | select(.is_linked_worktree | not) | .path) // empty' \
    <<<"$worktrees"
)"

# One row per *linked* worktree (the primary checkout is where you already are):
#   field1 = glyph + branch + basename (shown)   ● = open, ○ = on disk only
#   field2 = path            (hidden)
#   field3 = open_workspace_id, empty if closed  (hidden)
rows="$(
  jq -r '
    .result.worktrees[]
    | select(.is_linked_worktree)
    | [ ((if .open_workspace_id != null then "● " else "○ " end)
          + (.branch // "(detached)") + "  " + (.path | split("/") | last)),
        .path,
        (.open_workspace_id // "") ]
    | @tsv
  ' <<<"$worktrees"
)"

if [ -z "$rows" ]; then
  printf 'no worktrees for this repo yet (create one with prefix+shift+g)\n'
  sleep 1.5
  exit 0
fi

fzf_opts=(
  --ansi --layout=reverse --border=rounded --info=inline-right
  --highlight-line --no-scrollbar --pointer='▶'
  --delimiter='\t' --with-nth=1
  --prompt='worktree ❯ '
  --header='enter: open · ctrl-x: delete'
  --expect=ctrl-x
  --bind 'ctrl-j:down,ctrl-k:up'
  --color='fg:#c0caf5,bg:-1,hl:#bb9af7,fg+:#c0caf5,bg+:#283457,hl+:#7dcfff'
  --color='info:#7aa2f7,border:#3b4261,label:#7aa2f7,gutter:-1'
  --color='prompt:#7dcfff,pointer:#7dcfff,marker:#9ece6a,header:#9ece6a'
)

out="$(printf '%s\n' "$rows" | fzf "${fzf_opts[@]}")" || exit 0
key="${out%%$'\n'*}"        # first line: the pressed --expect key (empty on Enter)
sel="${out#*$'\n'}"         # remaining line: the chosen row
[ -n "$sel" ] || exit 0

path="$(cut -f2 <<<"$sel")"
wsid="$(cut -f3 <<<"$sel")"

confirm() {
  [ "$(printf 'no\nyes\n' | fzf --height=6 --info=hidden --prompt="$1 ")" = "yes" ]
}

if [ "$key" = "ctrl-x" ]; then
  confirm "delete $(basename "$path")?" || exit 0
  if [ -n "$wsid" ]; then
    herdr worktree remove --workspace "$wsid" --force >/dev/null
  elif [ -n "$main_path" ]; then
    git -C "$main_path" worktree remove --force "$path" >/dev/null
  fi
elif [ -n "$wsid" ]; then
  herdr workspace focus "$wsid" >/dev/null
else
  herdr worktree open --workspace "$ws" --path "$path" --focus >/dev/null
fi
